# Every setting the WhatsApp bot reads. Copy this file to `.env` (same folder,
# the repo root; it is gitignored) and fill in the REQUIRED block — the rest can
# stay as it is. The server checks the required values when it boots and names
# any that are missing, so a bad copy fails loudly instead of answering nothing.
#
#   cp .env.example .env
#   cd app/whatsapp && docker compose up --build
#   docker compose logs tunnel      # the https://…trycloudflare.com URL for Meta
#
# Then in the Meta app dashboard > WhatsApp > Configuration > Webhook:
#   Callback URL   <that URL>/webhook
#   Verify token   the WHATSAPP_VERIFY_TOKEN below
#   Subscribe to   messages


# ============================================================================
# REQUIRED
# ============================================================================

# Lets the bot send messages. Meta app dashboard > WhatsApp > API Setup >
# "Temporary access token" (dies after 24h). For anything longer-lived:
# business.facebook.com > Business settings > Users > System users > Generate
# new token, with scopes whatsapp_business_messaging + whatsapp_business_management.
WHATSAPP_ACCESS_TOKEN=

# The sending number's id (a long number, NOT the phone number itself).
# Meta app dashboard > WhatsApp > API Setup > "Phone number ID".
WHATSAPP_PHONE_NUMBER_ID=

# A string you make up. Paste the same one into Meta's webhook config; Meta
# sends it back once to prove the callback URL is yours. To make one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WHATSAPP_VERIFY_TOKEN=

# The key for the answer engine (EILAF_GENERATOR below; gemini by default).
# Free: https://aistudio.google.com/apikey
GEMINI_API_KEY=


# ============================================================================
# REQUIRED ON A PUBLIC HOST (EILAF_ENV=prod refuses to boot without these)
# ============================================================================

# Proves an incoming webhook really came from Meta. Without it anyone who finds
# the URL can drive the bot. Meta app dashboard > App settings > Basic >
# App secret > Show.
WHATSAPP_APP_SECRET=

# S3 bucket for conversations a user asked us to keep (and, under
# EILAF_ENV=dev, every conversation and the service log). Blank writes them to
# data/reports/ on this machine instead. No AWS key goes in this file: on EC2,
# boto3 uses the instance role, which needs s3:PutObject on the prefix.
EILAF_REPORT_BUCKET=
# Key prefix inside the bucket.
EILAF_REPORT_PREFIX=conversations/
# The bucket's region, e.g. eu-north-1. Set it whenever the bucket is set: left
# blank, boto3 inside the container guesses us-east-1 and fails with a
# confusing PermanentRedirect against a bucket anywhere else.
EILAF_REPORT_REGION=


# ============================================================================
# ANSWER ENGINE
# ============================================================================

# Which model phrases the answer from the retrieved passages:
#   gemini    Google Gemini, free tier, rotating models    needs GEMINI_API_KEY
#   claude    Anthropic API                                needs ANTHROPIC_API_KEY
#   bedrock   the same Claude, on your AWS account         needs EILAF_BEDROCK_REGION
#   cerebras  Cerebras free tier                           needs CEREBRAS_API_KEY
#   echo      no model: replies with the passages verbatim needs nothing
# `echo` is the way to test the wiring before you have any key.
EILAF_GENERATOR=gemini

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Bedrock takes no key — AWS credentials come from the instance role (or
# AWS_PROFILE locally), which needs bedrock:InvokeModel. Deliberately no
# default region: botocore would silently pick us-east-1 and move
# conversations out of the EU.
EILAF_BEDROCK_REGION=
# Blank derives the model id from the region; set it to pin an id from
# `aws bedrock list-inference-profiles`.
EILAF_BEDROCK_MODEL=


# ============================================================================
# OPTIONAL FEATURES
# ============================================================================

# Not a secret, and nothing needs it to run: set it and the boot check also
# reports how many days the access token has left.
# Meta app dashboard > App settings > Basic > App ID.
WHATSAPP_APP_ID=

# Recognise a returning user (and greet them in their language) by a salted
# hash of their number — the number itself is never stored. Blank turns it
# off. A secret; changing it forgets everyone. Make one like the verify token.
EILAF_USER_SALT=
# Where those records live. Blank: data/users/users.sqlite.
EILAF_USER_DB=

# 1 asks for the event, gender and age BEFORE answering. Off by default: the
# corpus carries almost no such tags yet, so it only delays the answer.
WHATSAPP_COLLECT_FACTS=

# Pull the corpus from S3 before the server starts, e.g.
# s3://your-bucket/model/data/ — only changed files are downloaded. Blank uses
# the corpus already in data/static/ (build it with ./scripts/curate_data.sh).
# The instance role needs s3:ListBucket on the bucket, s3:GetObject on the prefix.
EILAF_CORPUS_S3_URI=
# The corpus bucket's region. Blank falls back to EILAF_REPORT_REGION.
EILAF_CORPUS_REGION=


# ============================================================================
# TUNING (the defaults are fine)
# ============================================================================

# Move the whole corpus store (raw/, enriched/, .embeddings/). Blank: data/static.
EILAF_STATIC_DIR=
# Seconds of silence before a conversation is dropped and starts fresh (3h).
EILAF_SESSION_TTL=10800
# Server log level.
EILAF_LOG_LEVEL=INFO
# Under EILAF_ENV=dev, the sub-prefix the service log is written to.
EILAF_LOG_PREFIX=logs
# Where reports go when no bucket is set. Blank: data/reports.
EILAF_REPORT_DIR=
# Meta Graph API version, pinned so a Meta-side default bump changes nothing.
GRAPH_API_VERSION=v21.0


# ============================================================================
# NOT HERE: set these in the shell, per run
# ============================================================================
# docker compose only reads these from the command line, e.g.
#   EILAF_ENV=prod docker compose up -d
# A value written in this file is ignored for them.
#
#   EILAF_ENV            blank (local), dev (test deployment: keeps EVERY
#                        conversation and says so to the user) or prod (public
#                        host). scripts/deploy.sh --env sets it for you.
#   SKIP_DATA_CURATION   0 rebuilds the corpus at boot (scrape, enrich, embed).
#                        Default 1: start on the corpus as it is.
#   ENRICH_PROVIDER      the LLM that boot-time curation uses (default gemini).
#   ENRICH_LIMIT         cap on segments that curation sends to the LLM.
#   TUNNEL_TOKEN         a Cloudflare named tunnel's token, for a webhook URL
#   TUNNEL_RUN_ARGS      that survives restarts. Set both: TUNNEL_RUN_ARGS=run.
