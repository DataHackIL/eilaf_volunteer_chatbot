# Hidden folders
.claude/
.agents/
.venv/
.env/
.idea/
.vscode/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.cache/
.tox/
.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
*.egg

# Environment / secrets. The bare `.env` pattern matches that name ONLY —
# a `.env.bak.<stamp>` from a token rotation would be untracked but NOT
# ignored, i.e. one `git add -A` away from committing live credentials.
.env
.env.bak.*
*.local

# Logs
*.log

# Local knowledge store (data files kept out of git) — raw/ and enriched/ subdirs
data/static/**/*.docx
data/static/**/*.pdf
data/static/**/*.txt
data/static/**/*.json

# Cached corpus embeddings (regenerated on demand)
data/static/**/.embeddings/

# Reported conversations written by the local (dev-only) report store. Real
# conversations, kept because a user asked us to — they belong in the bucket,
# never in git.
data/reports/

# AWS spend snapshots written by scripts/aws_costs.py. Untracked on purpose:
# it is a running record of what the account is billed, which is nobody's
# business but ours. Drop this line if you'd rather keep the history in git.
data/costs/

# Local compose overrides (per-machine dev tweaks, never shared)
docker-compose.override.yml
